{
  "name": "@opentranscription/cli",
  "version": "0.1.0",
  "description": "Transcribe audio from your terminal or coding agent — the `ot` command.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "transcription",
    "speech-to-text",
    "stt",
    "cli",
    "agent",
    "claude-code",
    "opentranscription"
  ],
  "homepage": "https://opentranscription.io",
  "bugs": {
    "url": "https://github.com/OpenTranscription/skills/issues"
  },
  "bin": {
    "ot": "./dist/bin/ot.js"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@opentranscription/sdk": "0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenTranscription/skills.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc --build --force tsconfig.json"
  }
}
