{
  "name": "@opentranscription/sdk",
  "version": "0.1.1",
  "description": "Typed client for the OpenTranscription API — upload, transcribe, poll, and read results.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "transcription",
    "speech-to-text",
    "stt",
    "whisper",
    "deepgram",
    "assemblyai",
    "opentranscription"
  ],
  "homepage": "https://opentranscription.io",
  "bugs": {
    "url": "https://github.com/OpenTranscription/skills/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenTranscription/skills.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc --build --force tsconfig.json"
  }
}
